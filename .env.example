# Copy to .env and fill in. .env is gitignored; never commit real values.

# Host port for the local Postgres (the tests' mf-pg uses 5433)
MF_PG_PORT=5434
# Host port for Metabase
MF_MB_PORT=3000
# Password of the Postgres superuser "postgres"
POSTGRES_PASSWORD=change-me
# Password of the read-only role mf_reader (Metabase's data connection)
MF_READER_PASSWORD=change-me
# Password of the role "metabase" that owns Metabase's own app database
MB_DB_PASSWORD=change-me
# Metabase admin account created by the provisioner
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=change-me
# Path to the old repo that import_old reads (read only)
MF_OLD_REPO=/path/to/old/repo
